
#!/bin/sh

STATUS="/tmp/hornetwrt-autoapn.status"
LOGTAG="hornetwrt-autoapn"
CONFIG="/etc/config/hornetwrt-autoapn"
APN_DB="/etc/hornetwrt/apn-db.csv"
AT_LOCK="/var/lock/aw1000-modem.lock"
PORT_HELPER="/usr/sbin/aw1000-modem-ports"

INTERVAL="$(uci -q get hornetwrt-autoapn.main.interval)"
[ -n "$INTERVAL" ] || INTERVAL=60

log_msg() {
    logger -t "$LOGTAG" "$*"
}

set_status() {
    {
        echo "time=$(date '+%Y-%m-%d %H:%M:%S')"
        echo "status=$1"
        echo "message=$2"
        echo "device=${3:-unknown}"
        echo "operator=${4:-unknown}"
        echo "apn=${5:-unknown}"
        echo "auto_apply=disabled"
    } > "$STATUS"

    log_msg "$1: $2"
}

detect_modem() {
    for dev in /dev/cdc-wdm*; do
        [ -c "$dev" ] || continue
        echo "$dev"
        return 0
    done
    return 1
}

get_at_port() {
    [ -x "$PORT_HELPER" ] || return 1

    port="$("$PORT_HELPER" port at 2>/dev/null)"
    [ -c "$port" ] || return 1

    echo "$port"
}

at_read() {
    atdevice="$1"
    cmd="$2"

    [ -c "$atdevice" ] || return 1
    command -v sms_tool >/dev/null 2>&1 || return 1
    command -v flock >/dev/null 2>&1 || return 1

    (
        waited=0

        while ! flock -n -x 9; do
            [ "$waited" -ge 20 ] && exit 1
            sleep 1
            waited=$((waited + 1))
        done

        sms_tool -d "$atdevice" at "$cmd" 2>/dev/null
    ) 9>>"$AT_LOCK"
}

get_operator() {
    response="$(at_read "$1" 'AT+COPS?')" || return 1

    printf '%s\n' "$response" |
        sed -n 's/.*+COPS: [^,]*,[^,]*,"\([^"]*\)".*/\1/p' |
        head -n 1
}

lookup_apn() {
    wanted="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"

    [ -n "$wanted" ] || return 1
    [ -r "$APN_DB" ] || return 1

    while IFS=, read -r name apn match state; do
        case "$name" in
            ""|\#*) continue ;;
        esac

        name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

        if [ "$wanted" = "$name" ]; then
            echo "$name|$apn|$match|$state"
            return 0
        fi
    done < "$APN_DB"

    return 1
}

scan_once() {
    dev="$(detect_modem)" || {
        set_status "NO_MODEM" "Modem Quectel tidak dikesan."
        return 1
    }

    atdevice="$(get_at_port)" || {
        set_status "NO_AT_PORT" "Port AT rasmi AW1000 tidak tersedia." "$dev"
        return 1
    }

    operator="$(get_operator "$atdevice")"

    [ -n "$operator" ] || {
        set_status "OPERATOR_UNKNOWN" \
            "Nama operator tidak dapat dibaca melalui AT command." "$atdevice"
        return 0
    }

    profile="$(lookup_apn "$operator")" || {
        set_status "PROFILE_NOT_FOUND" \
            "Operator tiada dalam database. APN tidak diubah." \
            "$atdevice" "$operator"
        return 0
    }

    IFS='|' read -r name apn match state <<EOF
$profile
EOF

    if [ "$state" = "verified" ] && [ -n "$apn" ]; then
        set_status "PROFILE_VERIFIED" \
            "Profil disahkan. Mod pemeriksaan sahaja; APN belum diubah." \
            "$atdevice" "$name" "$apn"
    else
        set_status "PROFILE_MANUAL" \
            "Operator dikenal pasti tetapi APN belum disahkan. Tiada perubahan dibuat." \
            "$atdevice" "$name" "${apn:-not-set}"
    fi

    return 0
}

case "$1" in
    scan)
        scan_once
        ;;
    status)
        if [ -f "$STATUS" ]; then
            cat "$STATUS"
        else
            echo "Status Auto APN belum tersedia."
        fi
        ;;
    daemon)
        while true; do
            scan_once
            sleep "$INTERVAL"
        done
        ;;
    *)
        echo "Penggunaan: $0 {scan|status|daemon}"
        exit 1
        ;;
esac
